# SMART Big Data Customer Analytics & Recommendation Engine
# Environment Configuration (Optional - Defaults are built-in)

# Server Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
PORT=5000
VITE_API_URL=http://127.0.0.1:5000/api

# Java Configuration (Required for PySpark & Hadoop)
# Uncomment and point to your JDK if not already configured in your system PATH:
# JAVA_HOME=C:\Program Files\Java\jdk-11
# or on Linux/Mac:
# JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64

# Hadoop HDFS Mode:
# 'AUTO' - Automatically checks for running Hadoop cluster (WSL2 / Linux / localhost:9000).
# If Hadoop is not detected, gracefully uses local parquet/CSV staging with zero crashes.
HADOOP_MODE=AUTO
WSL_DISTRO=Debian
HDFS_PORT=9000

